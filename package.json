{
  "name": "fairway-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node init && npm run dev --workspace=client",
    "dev:client": "node init && npm run dev --workspace=client",
    "dev:server": "node init && npm run dev --workspace=server",
    "dev:all": "node init && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "node init && npm run build --workspace=client && npm run build --workspace=server",
    "build:client": "node init && npm run build --workspace=client",
    "build:server": "node init && npm run build --workspace=server",
    "preview": "npm run preview --workspace=client",
    "lint": "npm run lint --workspace=client",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.7.3"
  }
}
